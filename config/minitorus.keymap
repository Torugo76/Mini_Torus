//Inicio das incluçoes

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
//#include <dt-bindings/zmk/pointing.h>

//Fim das incluçoes


//Inicio das definiçoes de configurações
  //MOUSE

    #define ZMK_POINTING_DEFAULT_MOVE_VAL 1000  // padrão: 600
    #define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // padrão: 10

  //Fim MOUSE  

  //Inicio das definiçoes das camadas

    #define BASE 0
    #define NUM_ESQ 1
    #define NUM_DIR 2
    #define NAV_ESQ 3
    #define NAV_DIR 4
    #define FUNC 5
    #define MEDIA 6
    #define BT 7
    #define HRM_ESQ 8
    #define HRM_DIR 9

  //Fim das definiçoes das camadas

  //Inicio dos comportamentos de teclas
    //MT = MOD-TAP, se eu tocar o SHIFT pelo tempo menor que delimitei, ele vira o caps_word, caso eu continue pressionando o shift, ele se mantem como shift 
    //SK = 
  //Fim dos comportamentos de teclas

// Fim das definiçoes


&lt {
    retro-tap;
    flavor = "tap-preferred";
};

/ {
  // Ative a camada 'AMBAS' pressionando DIREITA e ESQUERDA
  conditional_layers {
    compatible = "zmk,conditional-layers";
  };
  //Fim

  //Inicio Combos
  combos {
    compatible = "zmk,combos";
    Sen1 {
      bindings = <&Sen1>;
      key-positions = <14 3 2>;
      layers = <BASE>;
    };

    // PONTO NA ESQUERDA (Teclas 9 e 0)
    ponto_esq {
      timeout-ms = <50>;
      key-positions = <22 23>;
      bindings = <&kp DOT>;
      layers = <NUM_ESQ>; // Só funciona na camada de números esquerda
    };

    // PONTO NA DIREITA (Teclas 0 e 7)
    ponto_dir {
      timeout-ms = <50>;
      key-positions = <26 27>;
      bindings = <&kp KP_DOT>; // Usando KP_DOT (Ponto de Numpad)
      layers = <NUM_DIR>; // Só funciona na camada de números direita
    };
  };
  //Fim


  //inicio macro
  macros {
    Sen1: Sen1 {
      compatible = "zmk,behavior-macro";
      #binding-cells = <0>;
      bindings =
        <&macro_tap>,
        <&kp AT &kp LS(K) &kp O &kp LS(D) &kp A &kp UNDER &kp LS(M) &kp A &kp S &kp LS(T) &kp E &kp R &kp EXCL &kp N6 &kp N4 &kp N2 &kp N8 &kp N9 &kp N0 &kp ENTER>;
      label = "SEN1";
    };
  };
  //fim macro


  behaviors {
    hm: homerow_mods {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      tapping-term-ms = <165>;
      flavor = "tap-preferred";
      bindings = <&kp>, <&kp>;
      retro-tap;
    };

    // POLEGAR ESQUERDO EXTERNO (1x = F1 a F12 | 2x = Bluetooth)
    td_esq_out: td_esq_out {
      compatible = "zmk,behavior-tap-dance";
      label = "TD_ESQ_OUT";
      #binding-cells = <0>;
      bindings = <&mo FUNC>, <&mo BT>;
    };

    // POLEGAR ESQUERDO INTERNO (1x = Setas Esq | 2x = Números Esq)
    td_esq_in: td_esq_in {
      compatible = "zmk,behavior-tap-dance";
      label = "TD_ESQ_IN";
      #binding-cells = <0>;
      bindings = <&mo NAV_ESQ>, <&mo NUM_ESQ>;
    };

    // POLEGAR DIREITO INTERNO (1x = Setas Dir | 2x = Números Dir)
    td_dir_in: td_dir_in {
      compatible = "zmk,behavior-tap-dance";
      label = "TD_DIR_IN";
      #binding-cells = <0>;
      bindings = <&mo NAV_DIR>, <&mo NUM_DIR>;
    };

    // POLEGAR DIREITO EXTERNO (1x = Mídia | 2x = Bluetooth)
    td_dir_out: td_dir_out {
      compatible = "zmk,behavior-tap-dance";
      label = "TD_DIR_OUT";
      #binding-cells = <0>;
      bindings = <&mo MEDIA>, <&mo BT>;
    };

    HRM_ESQ: HRM_ESQ {
      compatible = "zmk,behavior-tap-dance";
      label = "HRM_ESQ";
      #binding-cells = <0>;
      bindings = <&kp SPACE>, <&mo 8>;
    };

    HRM_DIR: HRM_DIR {
      compatible = "zmk,behavior-tap-dance";
      label = "HRM_DIR";
      #binding-cells = <0>;
      bindings = <&kp SPACE>, <&mo 9>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    // Inicio do Layout BASE
    default_layer {
      display-name = "BASE";
      // ┌─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┐
      // │  Q  │  W  │  E  │  R  │  T  │                │  Y  │  U  │  I  │  O  │  P  │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │  A  │  S  │  D  │  F  │  G  │                │  H  │  J  │  K  │  L  │ ; ' │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │  Z  │  X  │  C  │  V  │  B  │                │  N  │  M  │  ,  │  .  │ \ / │
      // └─────┴─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┴─────┘
      //             │ 1x: │ 1x: │ SEG:│                │ SEG:│ 1x: │ 1x: │
      //             │ FUNC│ NAV │HRM_E│                │HRM_D│ NAV │MEDIA│
      //             │     │     │     │                │     │     │     │
      //             │ 2x: │ 2x: │     │                │     │ 2x: │ 2x: │
      //             │ BT  │ NUM │     │                │     │ NUM │ BT  │
      //             └─────┴─────┴─────┘                └─────┴─────┴─────┘
      bindings = <
        &kp Q       &kp W       &kp E        &kp R        &kp T             &kp Y        &kp U      &kp I      &kp O    &kp P
        &kp A       &kp S       &kp D        &kp F        &kp G             &kp H        &kp J      &kp K      &kp L    &mt SQT SEMI
        &kp Z       &kp X       &kp C        &kp V        &kp B             &kp N        &kp M      &kp COMMA  &kp DOT  &mt BSLH FSLH
        &td_esq_out &td_esq_in  &lt 8 SPACE               &lt 9 SPACE       &td_dir_in   &td_dir_out
      >;
    };

    NUM_ESQ {
      display-name = "Num_Esq";
      // ┌─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┐
      // │  1  │  2  │  3  │ = [ │ ENT │                │  +  │  =  │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │  4  │  5  │  6  │ - ] │ BSP │                │  *  │  -  │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │  7  │  8  │  9  . , 0 │ DEL │                │  /  │     │     │     │     │
      // └─────┴─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┴─────┘
      //             │     │     │     │                │     │     │     │
      //             └─────┴─────┴─────┘                └─────┴─────┴─────┘
      bindings = <
        &kp N1  &kp N2  &kp N3  &mt EQUAL LBKT  &kp ENTER                    &kp KP_PLUS      &kp EQUAL     &none  &none  &none
        &kp N4  &kp N5  &kp N6  &mt MINUS RBKT  &mt LC(BACKSPACE) BACKSPACE  &kp KP_MULTIPLY  &kp KP_MINUS  &none  &none  &none
        &kp N7  &kp N8  &kp N9  &mt COMMA N0    &kp DEL                      &kp KP_DIVIDE    &none         &none  &none  &none
        &none   &none   &none                                                &none            &none         &none
      >;
    };

    NUM_DIR {
      display-name = "Num_Dir";
      // ┌─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┐
      // │     │     │     │  =  │  +  │                │ ENT │ [ = │  1  │  2  │  3  │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │     │     │     │  -  │  *  │                │ BSP │ ] - │  4  │  5  │  6  │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │     │     │     │     │  /  │                │ DEL │ 0 , │  7  │  8  │  9  │
      // └─────┴─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┴─────┘
      //             │     │     │     │                │     │     │     │
      //             └─────┴─────┴─────┘                └─────┴─────┴─────┘
      bindings = <
        &none  &none  &none  &kp EQUAL     &kp KP_PLUS        &kp ENTER      &mt LBKT EQUAL   &kp KP_N1  &kp KP_N2  &kp KP_N3
        &none  &none  &none  &kp KP_MINUS  &kp KP_MULTIPLY    &kp BACKSPACE  &mt RBKT MINUS   &kp KP_N4  &kp KP_N5  &kp KP_N6
        &none  &none  &none  &none         &kp KP_DIVIDE      &kp DEL        &mt KP_N0 COMMA  &kp KP_N7  &kp KP_N8  &kp KP_N9
        &none  &none  &none                                   &none          &none            &none
      >;
    };

    NAV_ESQ {
      display-name = "Nav_Esq";
      // ┌─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┐
      // │     │     │  ▲  │     │ ENT │                │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │     │  ◄  │  ▼  │  ►  │ BSP │                │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │     │ PGD │ PGU │     │ DEL │                │     │     │     │     │     │
      // └─────┴─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┴─────┘
      //             │     │     │     │                │     │     │     │
      //             └─────┴─────┴─────┘                └─────┴─────┴─────┘
      bindings = <
        &none &none      &kp UP     &none      &kp ENTER          &none  &none  &none  &none  &none
        &none &kp LEFT   &kp DOWN   &kp RIGHT  &kp BACKSPACE      &none  &none  &none  &none  &none
        &none &kp PG_DN  &kp PG_UP  &none      &kp DEL            &none  &none  &none  &none  &none
        &none &none      &none                                    &none  &none  &none
      >;
    };

    NAV_DIR {
      display-name = "Nav_Dir";
      // ┌─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┐
      // │     │     │     │     │     │                │ ENT │     │  ▲  │     │ - = │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │     │     │     │     │     │                │ BSP │  ◄  │  ▼  │  ►  │  ~  │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │     │     │     │     │     │                │ DEL │     │ PGU │ PGD │  \  │
      // └─────┴─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┴─────┘
      //             │     │     │     │                │     │     │     │
      //             └─────┴─────┴─────┘                └─────┴─────┴─────┘
      bindings = <
        &none  &none  &none  &none  &none         &kp ENTER      &none     &kp UP     &none      &mt MINUS EQUAL
        &none  &none  &none  &none  &none         &kp BACKSPACE  &kp LEFT  &kp DOWN   &kp RIGHT  &kp TILDE
        &none  &none  &none  &none  &none         &kp DEL        &none     &kp PG_UP  &kp PG_DN  &kp BSLH
        &none  &none  &none                       &none          &none     &none
      >;
    };

    FUNC {
      display-name = "Func";
      // ┌─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┐
      // │ F1  │ F2  │ F3  │ F12 │     │                │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │ F4  │ F5  │ F6  │ F11 │     │                │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │ F7  │ F8  │ F9  │ F10 │     │                │     │     │     │     │     │
      // └─────┴─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┴─────┘
      //             │TRANS│     │     │                │     │     │     │
      //             └─────┴─────┴─────┘                └─────┴─────┴─────┘
      bindings = <
        &kp F1  &kp F2  &kp F3  &kp F12  &none            &none  &none  &none  &none  &none
        &kp F4  &kp F5  &kp F6  &kp F11  &none            &none  &none  &none  &none  &none
        &kp F7  &kp F8  &kp F9  &kp F10  &none            &none  &none  &none  &none  &none
        &none  &none   &none                             &none  &none  &none
      >;
    };

    MEDIA {
      display-name = "Media";
      // ┌─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┐
      // │     │     │     │     │     │                │     │     │ VOL+│ >|| │     │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │     │     │     │     │     │                │     │ |<< │ VOL-│ >>| │     │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │     │     │     │     │     │                │     │ <<  │ MUTE│  >> │     │
      // └─────┴─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┴─────┘
      //             │     │     │UNLCK│                │     │     │TRANS│
      //             └─────┴─────┴─────┘                └─────┴─────┴─────┘
      bindings = <
        &none  &none  &none  &none  &none            &none  &none       &kp C_VOL_UP  &kp C_PP    &none
        &none  &none  &none  &none  &none            &none  &kp C_PREV  &kp C_VOL_DN  &kp C_NEXT  &none
        &none  &none  &none  &none  &none            &none  &kp C_RW    &kp C_MUTE    &kp C_FF    &none
        &none  &none  &studio_unlock                 &none  &none       &none
      >;
    };

    BT {
      display-name = "BT_All";
      // ┌─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┐
      // │ CLR │     │     │     │     │                │     │     │     │     │ CLR │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │ BT0 │ BT1 │ BT2 │ BT3 │ BT4 │                │ BT4 │ BT3 │ BT2 │ BT1 │ BT0 │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │C_ALL│     │     │     │     │                │     │     │     │     │C_ALL│
      // └─────┴─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┴─────┘
      //             │     │     │     │                │     │     │     │
      //             └─────┴─────┴─────┘                └─────┴─────┴─────┘
      bindings = <
        &bt BT_CLR      &none         &none         &none         &none           &none         &none         &none         &none         &bt BT_CLR
        &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0
        &bt BT_CLR_ALL  &none         &none         &none         &none           &none         &none         &none         &none         &bt BT_CLR_ALL
                                      &none         &none         &none           &none         &none         &none
      >;
    };

    HRM_ESQ {
      display-name = "HRM_ESQ";
      // ┌─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┐
      // │ ESC │     │     │ C_Y │ TAB │                │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │ WIN │ ALT │ CTL │ SFT │ CPS │                │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │ C_Z │ C_X │ C_C │ C_V │CS_V │                │     │     │     │     │     │
      // └─────┴─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┴─────┘
      //             │     │     │     │                │     │     │     │
      //             └─────┴─────┴─────┘                └─────┴─────┴─────┘
      bindings = <
        &kp ESC       &trans        &trans            &kp LC(Y)  &kp TAB                      &trans  &trans  &trans  &trans  &trans
        &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_CONTROL  &kp LSHFT  &kp CAPS                     &trans  &trans  &trans  &trans  &trans
        &kp LC(Z)     &kp LC(X)     &kp LC(C)         &kp LC(V)  &kp LC(LS(V))                &trans  &trans  &trans  &trans  &trans 
        &trans        &trans        &trans                                                    &trans  &trans  &trans
      >;
    };

    HRM_DIR {
      display-name = "HRM_DIR";
      // ┌─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┐
      // │     │     │     │     │     │                │ TAB │ C_Y │     │     │ ESC │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │     │     │     │     │     │                │ CPS │ SFT │ CTL │ ALT │ WIN │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │     │     │     │     │     │                │CS_V │ C_V │ C_C │ C_X │ C_Z │
      // └─────┴─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┴─────┘
      //             │     │     │     │                │     │     │     │
      //             └─────┴─────┴─────┘                └─────┴─────┴─────┘
      bindings = <
        &trans  &trans  &trans  &trans  &trans          &kp TAB        &kp LC(Y)  &trans     &trans     &kp ESC
        &trans  &trans  &trans  &trans  &trans          &kp CAPS       &kp LSHFT  &kp LCTRL  &kp LALT   &kp LGUI
        &trans  &trans  &trans  &trans  &trans          &kp LC(LS(V))  &kp LC(V)  &kp LC(C)  &kp LC(X)  &kp LC(Z)
        &trans  &trans  &trans                          &trans         &trans     &trans
      >;
    };

    //MOUSE {
    //   display-name = "ESQRD_MOUSE";
    //   bindings = <
      // ┌─────┬─────┬─────┬─────┬─────┐                ┌─────┬─────┬─────┬─────┬─────┐
      // │ MB3 │ MB4 │  ▲  │ MB5 │ SC↑ │                │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │     │  ◄  │  ▼  │  ►  │ SC↓ │                │     │     │     │     │     │
      // ├─────┼─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┼─────┤
      // │ TO0 │ SC← │ SC→ │     │     │                │     │     │     │     │     │
      // └─────┴─────┼─────┼─────┼─────┤                ├─────┼─────┼─────┼─────┴─────┘
      //             │     │ MB1 │ MB2 │                │     │     │     │
      //             └─────┴─────┴─────┘                └─────┴─────┴─────┘
    //    &mkp MB3  &mkp MB4        &mmv MOVE_UP    &mkp MB5         &msc SCRL_UP               &none  &none  &none  &none  &none
    //    &none     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN             &none  &none  &none  &none  &none
    //    &to 0     &msc SCRL_LEFT  &msc SCRL_RIGHT &none            &none                      &none  &none  &none  &none  &none
    //    &none     &mkp MB1        &mkp MB2                                                    &none  &none  &none
